# Copy this file to ".env" and fill in your real keys.
# Or just export them in your shell before running.

# The agents under test run on Claude
# (agent_plain.py, agent_instrumented.py, rag_agent.py)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The GPT-4o judge for all LLM-based metrics, the RAG embeddings,
# and chatbot.py (which runs on GPT-4o directly)
OPENAI_API_KEY=sk-your-key-here

# Optional: stream traces and eval results to the Confident AI dashboard.
# DeepEval picks this up automatically — no code changes needed.
# CONFIDENT_API_KEY=confident_us_your-key-here
